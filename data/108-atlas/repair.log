import os
import subprocess
import tempfile
import time
import urllib.request

runtime_dir = tempfile.mkdtemp(prefix='heb108-cdp-', dir='/private/tmp')
chrome_log = open(os.path.join(runtime_dir, 'chrome.log'), 'wb')
chrome = subprocess.Popen([
    '/Applications/Google Chrome.app/Contents/MacOS/Google Chrome',
    f'--user-data-dir={runtime_dir}/profile',
    '--remote-debugging-port=9222',
    '--remote-debugging-address=127.0.0.1',
    '--no-first-run',
    '--no-default-browser-check',
    '--no-sandbox',
    '--disable-dev-shm-usage',
    '--disable-gpu',
    '--disable-software-rasterizer',
    'about:blank',
], stdout=chrome_log, stderr=subprocess.STDOUT)
try:
    ready = False
    for _ in range(40):
        try:
            with urllib.request.urlopen('http://127.0.0.1:9222/json/version', timeout=1) as response:
                print(response.read().decode(), flush=True)
            ready = True
            break
        except Exception:
            if chrome.poll() is not None:
                break
            time.sleep(0.25)
    if not ready:
        chrome_log.flush()
        print(open(os.path.join(runtime_dir, 'chrome.log'), errors='replace').read(), flush=True)
        raise SystemExit('temporary Chrome did not expose CDP')
    environment = os.environ.copy()
    environment.update({
        'HEB_START_TIER': '3',
        'HEB_CDP_URL': 'http://127.0.0.1:9222',
        'HEB_RUNTIME_DIR': runtime_dir,
    })
    result = subprocess.run(
        ['python3', 'calibrate.py', '108', '--verify'],
        env=environment,
        check=False,
    )
    raise SystemExit(result.returncode)
finally:
    if chrome.poll() is None:
        chrome.terminate()
        try:
            chrome.wait(timeout=5)
        except subprocess.TimeoutExpired:
            chrome.kill()
            chrome.wait()
    chrome_log.close()
