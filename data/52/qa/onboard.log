import copy
from router import derive, engine
cfg0=derive.load_store('data/52')
zs=cfg0['seal_zones']
for label, zones in [
    ('none', []),
    ('service_only', [z for z in zs if 'rect' not in z]),
    ('check_only', [z for z in zs if 'rect' in z]),
    ('bakery_only', [z for z in zs if z.get('name','').startswith('Bakery')]),
    ('all_except_check', [z for z in zs if 'rect' not in z]),
]:
    cfg=copy.deepcopy(cfg0); cfg['seal_zones']=zones
    b=derive.build_free(cfg)
    print(label, 'zones',len(zones),'raw',round(b['free_raw'].mean()*100,2),'uncut',round(b['free_uncut'].mean()*100,2),'reach',round((b['reach']>=0).mean()*100,2),'free',round(b['free'].mean()*100,2),'culled',len(b['culled']), 'largest',sorted([x[0] for x in b['culled']],reverse=True)[:4])
    for name in ['AISLE 1','AISLE 10','PHARMACY','BAKERY','FLORAL','SEAFOOD','DELI']:
      x,y=cfg['anchors'][name]; cx,cy=int(x//2),int(y//2)
      ok=b['free'][cy,cx]
      if ok:
        try: s=engine.snap(b['free'],b['reach'],(x,y)); ss=(s[0]*2+1,s[1]*2+1)
        except Exception as e: ss=str(e)
      else: ss='blocked'
      print(' ',name,ok,ss)
