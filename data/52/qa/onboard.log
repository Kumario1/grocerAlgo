from scipy import ndimage
from router import derive, engine
c=derive.load_store('data/52')
raw=engine.build_grid(c['geom'])
# raw seed
seed=engine.nearest_free(raw,c['anchors']['ENTRANCE'])
rr,_=engine.bfs(raw,seed); rawreach=rr>=0
print('raw seed',seed,'raw comps')
lab,n=ndimage.label(raw)
for i in sorted(range(1,n+1),key=lambda i:(lab==i).sum(),reverse=True)[:15]:
 m=lab==i; ys,xs=np.where(m); print(int(m.sum()), [xs.min()*2,ys.min()*2,xs.max()*2+2,ys.max()*2+2], 'seed?',m[seed[1],seed[0]])
print('raw reachable',rawreach.sum())
# no zones build details
for label,zs in [('none',[]),('bakery',[c['seal_zones'][0]])]:
 out,culled,staff=engine.seal_staff_gaps(raw,c['anchors']['ENTRANCE'],seal_zones=zs,protect_pts=[v for k,v in c['anchors'].items() if k.startswith('AISLE ')],service_pts=[v for k,v in c['anchors'].items() if any(s in k for s in engine.SERVICE_DEPTS)])
 seed2=engine.nearest_free(out,c['anchors']['ENTRANCE']); rr,_=engine.bfs(out,seed2)
 print('\\n',label,'seed',seed2,'out comps')
 lab,n=ndimage.label(out)
 for i in sorted(range(1,n+1),key=lambda i:(lab==i).sum(),reverse=True)[:10]:
  m=lab==i; ys,xs=np.where(m); print(int(m.sum()), [xs.min()*2,ys.min()*2,xs.max()*2+2,ys.max()*2+2], 'seed?',m[seed2[1],seed2[0]],'reach?',int((m&(rr.reshape(out.shape)>=0)).sum()))
