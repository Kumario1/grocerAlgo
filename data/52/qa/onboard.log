/bin/zsh -lc "python3 - <<'PY'
import json, numpy as np
from router import derive, engine
cfg=derive.load_store('data/52')
b=derive.build_free(cfg)
free=b['free']; raw=b['free_raw']; reach=(b['reach']>=0).reshape(free.shape)
print('shape',free.shape,'raw/free/reach',raw.mean(),free.mean(),reach.mean(),'seed',b['seed'])
for name in ['AISLE 1','AISLE 2','AISLE 3','AISLE 4','AISLE 5','AISLE 6','AISLE 19','KITCHEN','BAKERY','FLORAL','PHARMACY','SEAFOOD','DELI','ENTRANCE']:
    x,y=cfg['anchors'][name]; cx,cy=int(x//engine.CELL),int(y//engine.CELL)
    print(name, (cx,cy), 'raw',raw[cy,cx], 'free',free[cy,cx], 'reach',reach[cy,cx])
    for r in [2,5,10,20,40,80,160]:
        y0=max(0,cy-r); y1=min(free.shape[0],cy+r+1); x0=max(0,cx-r); x1=min(free.shape[1],cx+r+1)
        print(' ',r,'raw',int(raw[y0:y1,x0:x1].sum()),'free',int(free[y0:y1,x0:x1].sum()),'reach',int(reach[y0:y1,x0:x1].sum()))
print('culled')
for item in sorted(b['culled'], reverse=True): print(item)
# label connected components in raw and free around anchor
from scipy import ndimage
for nm,m in [('raw',raw),('free',free),('reach',reach)]:
 lab,n=ndimage.label(m)
 x,y=cfg['anchors']['AISLE 1']; cx,cy=int(x//2),int(y//2)
 print(nm,'label',lab[cy,cx], 'size', (lab==lab[cy,cx]).sum() if lab[cy,cx] else 0)
