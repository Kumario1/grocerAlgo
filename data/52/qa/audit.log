from pathlib import Path
from PIL import Image,ImageDraw
import json
root=Path('/private/tmp/store52-audit')
guide=Image.open(root/'guide-page2.png').convert('RGB')
over=Image.open('data/52/qa/walkable_overlay.png').convert('RGB')
S=2
cfg={n:json.loads((Path('data/52')/n).read_text()) for n in ['exclusions.json','inclusions.json','seal_zones.json']}
# Show each config shape on the printed map and current overlay in its local context.
regions=[('pharmacy',(80,350,300,480)),('seafood',(850,145,1090,230)),('deli',(1000,220,1180,370)),('kitchen',(790,220,880,330)),('checkstands',(450,380,840,470))]
for name,(x0,y0,x1,y1) in regions:
 box=(x0*S,y0*S,x1*S,y1*S);g=guide.crop(box);o=over.crop(box)
 for entry in cfg['exclusions.json']:
  if 'poly' in entry:
   pts=[(int(x*S-box[0]),int(y*S-box[1])) for x,y in entry['poly']]
   for im in (g,o): ImageDraw.Draw(im).line(pts+[pts[0]],fill='magenta',width=5,joint='curve')
  else:
   x2,y2,x3,y3=entry['rect']; rr=(int(x2*S-box[0]),int(y2*S-box[1]),int(x3*S-box[0]),int(y3*S-box[1]))
   for im in (g,o): ImageDraw.Draw(im).rectangle(rr,outline='magenta',width=5)
 for entry in cfg['inclusions.json']:
  if 'rect' in entry:
   x2,y2,x3,y3=entry['rect']; rr=(int(x2*S-box[0]),int(y2*S-box[1]),int(x3*S-box[0]),int(y3*S-box[1]))
   for im in (g,o): ImageDraw.Draw(im).rectangle(rr,outline='blue',width=5)
 pair=Image.new('RGB',(g.width,g.height*2),'white');pair.paste(g,(0,0));pair.paste(o,(0,g.height))
 d=ImageDraw.Draw(pair);d.text((8,8),f'GUIDE config {name}',fill='red');d.text((8,g.height+8),f'OVERLAY config {name}',fill='red')
 pair.save(root/f'config-{name}.png')
