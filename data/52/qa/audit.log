overlay=Image.open('data/52/qa/walkable_overlay.png').convert('RGB')
coords=[
(720,428,'p01 EXIT'),(422,188,'p02 AISLE14'),(544,427,'p03 CHECKSTANDS'),
(1110,436,'p04 PRODUCE'),(841,186,'p05 AISLE1'),(143,185,'p06 AISLE20'),
(198,188,'p07 DAIRY'),(652,473,'p08 EXIT'),(147,213,'p09 AISLE20'),
(825,475,'p10 RESTROOMS'),(1075,213,'p11 DELI'),(770,474,'p12 RESTROOMS'),
(114,296,'p13 AISLE21'),(924,235,'p14 SEAFOOD'),
(288,190,'component-559'),(696,202,'component-261')]
W,H=guide.size
for x,y,label in coords:
    # 70pt half-width/height gives context; clamp to page.
    hw,hh=75,60
    x0=max(0,int((x-hw)*2)); x1=min(W,int((x+hw)*2))
    y0=max(0,int((y-hh)*2)); y1=min(H,int((y+hh)*2))
    gc=guide.crop((x0,y0,x1,y1)); oc=overlay.crop((x0,y0,x1,y1))
