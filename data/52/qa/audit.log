/bin/zsh -lc "python3 - <<'PY'
from pathlib import Path
from PIL import Image, ImageDraw
import numpy as np
from scipy import ndimage
from router import derive
root=Path('/private/tmp/store52-audit')
guide=Image.open(root/'guide-page2.png').convert('RGB')
overlay=Image.open('data/52/qa/walkable_overlay.png').convert('RGB')
W,H=guide.size
cfg=derive.load_store('data/52'); b=derive.build_free(cfg)
cull=b['free_raw'] & ~b['free_uncut']
lab,n=ndimage.label(cull)
items=[]
for i in range(1,n+1):
    m=lab==i; size=int(m.sum())
    if size < 100: continue
    ys,xs=np.where(m)
    x=float(xs.mean()*2); y=float(ys.mean()*2)
    items.append((size,i,x,y))
items.sort(reverse=True)
for rank,(size,i,x,y) in enumerate(items[:14],1):
    m=lab==i
    ys,xs=np.where(m)
    x0=max(0,int((xs.min()*2-40)*2)); x1=min(W,int((xs.max()+1)*2+40*2))
    y0=max(0,int((ys.min()*2-40)*2)); y1=min(H,int((ys.max()+1)*2+40*2))
    gc=guide.crop((x0,y0,x1,y1)); oc=overlay.crop((x0,y0,x1,y1)).copy()
    # Overlay the exact culled cells in blue at the 2x-render scale.
    local=(m[max(0,y0//2):min(m.shape[0],(y1+1)//2),max(0,x0//2):min(m.shape[1],(x1+1)//2)])
    # Should align due even coordinates; make exact local image with nearest resize.
    tint=Image.new('RGB',oc.size,(40,80,255))
