W,H=overlay.size
for row in range(3):
    for col in range(3):
        x0=col*W//3; x1=(col+1)*W//3
        y0=row*H//3; y1=(row+1)*H//3
        box=(x0,y0,x1,y1)
        overlay.crop(box).save(root/f'"'overlay-r{row+1}c{col+1}.png')
        guide.crop(box).save(root/f'guide-r{row+1}c{col+1}.png')
        # Put printed map above extracted overlay for direct paired inspection.
        pair=Image.new('RGB',(x1-x0,(y1-y0)*2),'white')
