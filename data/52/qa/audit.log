free=z['free']; cell=float(z['cell']); mpc=float(z['m_per_cell'])
over=np.array(Image.open('data/52/qa/walkable_overlay.png'))
# Dominant visual colors at exact grid-cell centers are useful evidence alongside the boolean truth.
def report(kind, pts):
    print(f'--- {kind} ({len(pts)}) ---')
    bad=0
    for x,y,why in pts:
        gx,gy=int(x//cell),int(y//cell)
        ok=0<=gy<free.shape[0] and 0<=gx<free.shape[1] and bool(free[gy,gx])
        px=(min(max(gx,0),free.shape[1]-1)*int(cell)+int(cell)//2)
        py=(min(max(gy,0),free.shape[0]-1)*int(cell)+int(cell)//2)
        rgb=tuple(int(v) for v in over[py,px])
        expected=kind=='must'
        status='PASS' if ok==expected else 'FAIL'; bad+=status=='FAIL'
