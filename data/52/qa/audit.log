        pair.paste(overlay.crop(box),(0,y1-y0))
        d=ImageDraw.Draw(pair)
        d.rectangle((0,0,pair.width-1,pair.height-1),outline=(255,0,0),width=4)
        d.text((12,12),f'GUIDE r{row+1}c{col+1}',fill=(255,0,0))
        d.text((12,(y1-y0)+12),f'OVERLAY r{row+1}c{col+1}',fill=(255,0,0))
        pair.save(root/f'pair-r{row+1}c{col+1}.png')
print('saved', len(list(root.glob('overlay-r*.png'))), 'overlay crops')
