placements=[]
for _,v in sqlite3.connect('runtime/onboarding-57/heb.sqlite').execute(\"select cache_key,value_json from cache where store_id=57 and kind='placement'\"):
 p=json.loads(v);n=int(p['location_label'].split()[-1]);placements.append((n,p,cli.corridor_segment(A['psas'],runs,p['group'],p['point'])))
placements.sort(key=lambda x:x[0])
def pin(a0,a1,g0,g1):return {'atlas':[a0,a1],'guide':[g0,g1]}
def live(rec,cfg={}):
 c=cal.transform(rec);m=[]
 for n,p,s in placements:
