import json, itertools, sqlite3, warnings
import calibrate as cli
from router import calibrate as cal
A=cal.load_atlas('57'); G=json.load(open('data/57/geometry.json')); P=cal.load_profile('57')
away=cal.floor_map(P); runs=cal.shelf_runs(A['psas'])
placements=[]
for _,value in sqlite3.connect('runtime/onboarding-57/heb.sqlite').execute(\"select cache_key,value_json from cache where store_id=57 and kind='placement'\"):
 p=json.loads(value); n=int(p['location_label'].split()[-1]); placements.append((n,p,cli.corridor_segment(A['psas'],runs,p['group'],p['point'])))
placements.sort(key=lambda x:x[0])

def eval_live(record, config):
 carry=cal.transform(record); misses=[]
 for n,p,seg in placements:
  want=cal.guide_aisle_name(config,n); got,agreed=cli.aisle_agreement(G['anchors'],want,[carry(e) for e in seg])
  if not agreed: misses.append(f'{n}:{want}->{got}')
 return ','.join(misses)
def pin(a0,a1,g0,g1): return {'atlas':[a0,a1],'guide':[g0,g1]}
xpin=pin(1,16,1,16); rows=[]
for a0,a1 in itertools.combinations(range(18,36),2):
 if a0 not in cal.aisle_anchors(A['geometry']['anchors']) or a1 not in cal.aisle_anchors(A['geometry']['anchors']): continue
 for shift in range(-2,3):
  g0,g1=a0+shift,a1+shift
  if g0 not in cal.aisle_anchors(G['anchors']) or g1 not in cal.aisle_anchors(G['anchors']): continue
  with warnings.catch_warnings():
   warnings.simplefilter('ignore'); rec=cal.fit(A['geometry'],G,{'x':xpin,'y':pin(a0,a1,g0,g1)})
  if not (rec['gates'].get('residual') and rec['gates'].get('scale_skew')): continue
  none=eval_live(rec,{}); m1=eval_live(rec,{'aisle_label_shift':{'from':19,'add':-1}})
  off=sum(m>cal.MAX_SNAP_M for _,m in cal.landings(P,rec,A['psas'],away=away)); floorpct=100*(len(A['psas'])-off)/len(A['psas'])
  if floorpct>=99: rows.append((floorpct,rec['y']['max_residual_pt'],rec['y']['scale'],rec['y']['offset'],a0,a1,g0,g1,none,m1))
rows.sort(key=lambda x:(len(x[8]),len(x[9]),-x[0],x[1]))
print('candidates',len(rows))
for x in rows[:100]: print('floor %.2f yscale %.4f off %.1f res %.2f A[%d,%d]->G[%d,%d] none:%s shift19:%s'%x)
