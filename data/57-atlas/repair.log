import json, itertools, numpy as np
from router import calibrate as cal
A=cal.aisle_anchors(json.load(open('data/57-atlas/geometry.json'))['anchors'])
G=cal.aisle_anchors(json.load(open('data/57/geometry.json'))['anchors'])

def pins(axis):
    vals=[]
    for a0,a1 in itertools.combinations(sorted(A),2):
      for g0,g1 in itertools.combinations(sorted(G),2):
        if g1-g0 "'!= a1-a0: continue
        shift=g0-a0
        nums=[n for n in range(a0,a1+1) if n in A and n+shift in G]
        if len(nums)<2: continue
        pts=[(A[n][axis],G[n+shift][axis],n) for n in nums]
        fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1)
