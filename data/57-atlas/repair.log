+def aisle_anchors(anchors):
+    """{aisle number: point} — the only anchors trustworthy enough to fit."""
+    out = {}
+    for name, point in anchors.items():
+        if name.startswith("AISLE "):
+            try:
+                out[int(name.split()[1])] = point
+            except ValueError:
+                continue
+    return out
