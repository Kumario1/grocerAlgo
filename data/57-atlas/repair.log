    """The city slug discover.py downloaded this store's guide under."""
    for path in sorted(glob.glob(f"{GUIDES_DIR}/guide-*-{store}.pdf")):
        name = os.path.basename(path)
        if name.endswith(f"-{store}.pdf"):
