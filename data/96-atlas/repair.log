AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
def line(a,b,sa,ga):
 return np.polyfit([AA[a][sa],AA[b][sa]],[GG[a][ga],GG[b][ga]],1)
x=line(1,13,1,0); y=np.polyfit([AA[n][0] for n in sorted(set(AA)&set(GG))],[GG[n][1] for n in sorted(set(AA)&set(GG))],1)
