xs=[x for x in xs if .45 <= abs(x['scale'])*aspan[1]/gspan[0] <= 1.75]
ys=[y for y in ys if .45 <= abs(y['scale'])*aspan[0]/gspan[1] <= 1.75]
print('foot scale',len(xs),len(ys),flush=True)
# prepare floor scorer sample points/away exactly like function
free,reach,cell,m=profile; away=cal.floor_map(profile); runs=cal.shelf_runs(atlas['psas']); keys=list(atlas['psas']); keys=keys[::max(1,len(keys)//400)]
points=np.asarray([cal.to_corridor(runs,f\"PSA:{k.split('|',2)[0]}:{k.split('|',2)[1]}\",atlas['psas'][k]) for k in keys])
# y cells for candidates
Y=[]
for y in ys:
 cy=((y['scale']*points[:,0]+y['offset'])//cell).astype(int)
 Y.append(cy)
Y=np.asarray(Y)
valid_y=[]
for i,y in enumerate(ys):
 valid_y.append(i)
# loop x; compute scores against all skew-compatible y
hits=[]
for ix,x in enumerate(xs):
 cx=((x['scale']*points[:,1]+x['offset'])//cell).astype(int)
 inside_x=(cx>=0)&(cx<free.shape[1])
 compatible=np.array([i for i,y in enumerate(ys) if abs(abs(x['scale']/y['scale'])-1)<=cal.MAX_SKEW],dtype=int)
 if not len(compatible): continue
 cy=Y[compatible]
 inside=inside_x[None,:] & (cy>=0) & (cy<free.shape[0])
 vals=np.full(inside.shape,np.inf)
 yy=np.broadcast_to(cy,inside.shape); xx=np.broadcast_to(cx,(len(compatible),len(cx)))
 vals[inside]=away[yy[inside],xx[inside]]
 scores=np.mean(vals<=cal.MAX_SNAP_M,axis=1)
 for j,score in zip(compatible,scores):
  if score>=.99:
   hits.append((float(score),x,ys[j]))
 if ix%200==0: print('x',ix,'hits',len(hits),flush=True)
print('hits',len(hits),flush=True)
for score,x,y in sorted(hits,key=lambda q:(q[0],len(q[1]['config']) if False else 0),reverse=True)[:200]:
