import json, collections, numpy as np
from router import calibrate as c
p=json.load(open('data/96-atlas/psas.json')); profile=c.load_profile('96'); base=json.load(open('data/96-atlas/calibration.json')); y=base['y']
A=json.load(open('data/96-atlas/geometry.json')); G=json.load(open('data/96/geometry.json'))
# x direct geometry consensus
x=c.axis_candidates(c.aisle_anchors(A['anchors']),c.aisle_anchors(G['anchors']),0,1,A['page']['h'])[0]
for nm,xx in [('baseline',base['x']),('anchor',x)]:
 cal={'x':xx,'y':y}; bad=[]
 for key,d in c.landings(profile,cal,p):
  if d>5: bad.append((key,d))
 print('\\n',nm,'bad >5',len(bad),'of',len(p))
 byarea=collections.Counter(k.split('|')[0] for k,d in bad); byaisle=collections.Counter(k.split('|')[1] for k,d in bad)
 print('area',byarea.most_common(30)); print('aisle',byaisle.most_common(30))
 print('all area counts')
 allarea=collections.Counter(k.split('|')[0] for k in p); print(allarea)
 print('bad sample',[(k,round(d,1)) for k,d in bad[:30]])
# Atlas geometry shelf runs grouped range by area+aisle
runs=c.shelf_runs(p)
print('\\nruns',len(runs))
for k,v in sorted(runs.items()):
 pts=[q for key,q in p.items() if tuple(key.split('|')[:2])==k]
 if k[0] in ('07','09','10') or k[1] in ('2','4','5','6','11','14','20','21','23'):
  print(k,'line',v,'range',[(round(min(q[i] for q in pts),1),round(max(q[i] for q in pts),1)) for i in (0,1)],'n',len(pts))
