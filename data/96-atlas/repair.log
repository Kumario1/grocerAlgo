for nm,geom in [('atlas',A),('guide',G)]:
 b=np.asarray(geom['boundary'])
 print(nm,'boundary bbox',b.min(0),b.max(0),'n',len(b),'area?')
# mapped atlas boundary and compare extrema
b=np.asarray(A['boundary']); mb=np.c_[x[0]*b[:,1]+x[1],y[0]*b[:,0]+y[1]]
