import json, numpy as np
from router import calibrate as cal
atlas=cal.load_atlas('96'); guide=json.load(open('data/96/geometry.json')); aa=cal.aisle_anchors(atlas['geometry']['anchors']); ga=cal.aisle_anchors(guide['anchors'])
def candidates(axis,source):
 out=[]; seen={}
 for a0 in sorted(aa):
  for a1 in sorted(aa):
   if a1<=a0: continue
   for g0 in sorted(ga):
    sh=g0-a0; g1=a1+sh
    if g1 not in ga: continue
    pts=[(aa[n][source],ga[n+sh][axis],n) for n in range(a0,a1+1) if n in aa and n+sh in ga]
    if len(pts)<2: continue
    fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1); res=max(abs(fit[0]*p[0]+fit[1]-p[1]) for p in pts)
    if res>cal.TOL_PT or not cal.SCALE_BAND[0]<=abs(fit[0])<=cal.SCALE_BAND[1]: continue
    key=(round(float(fit[0]),8),round(float(fit[1]),8))
    c=(a0,a1,sh,len(pts),float(fit[0]),float(fit[1]),float(res),[p[2] for p in pts])
    seen.setdefault(key,[]).append(c)
 for (scale,offset), configs in seen.items():
  c=configs[0]
  out.append({'config':c,'scale':scale,'offset':offset,'configs':configs})
 return out
xs=candidates(0,1); ys=candidates(1,0)
print('unique',len(xs),len(ys),'raw configs',sum(len(x['configs']) for x in xs),sum(len(y['configs']) for y in ys))
# only scale pairs plausible
pairs=[(x,y) for x in xs for y in ys if abs(abs(x['scale']/y['scale'])-1)<=cal.MAX_SKEW]
print('skew pairs',len(pairs))
print('x scale/offset range',min((x['scale'] for x in xs)),max((x['scale'] for x in xs)))
print('y scale/offset range',min((y['scale'] for y in ys)),max((y['scale'] for y in ys)))
