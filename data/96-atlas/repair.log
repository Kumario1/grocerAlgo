 return good,','.join(got)
def floor_pct(x,y,points):
 cx=((x['scale']*points[:,1]+x['offset'])//cell).astype(int); cy=((y['scale']*points[:,0]+y['offset'])//cell).astype(int)
 inside=(cx>=0)&(cx<free.shape[1])&(cy>=0)&(cy<free.shape[0]); landed=np.full(len(points),np.inf); landed[inside]=away[cy[inside],cx[inside]]
