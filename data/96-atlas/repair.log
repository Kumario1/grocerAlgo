  x={'scale':scale,'offset':float(offset),'source_axis':1}
  vals.append((score({'x':x,'y':base['y']}),offset,*labels(x)))
 best=sorted(vals,reverse=True)[:8]
 print('scale',scale,'best',[(round(v[0],3),v[1],v[2],v[3]) for v in best])
