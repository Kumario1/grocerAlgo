import json, itertools, numpy as np
import calibrate as cli
from router import calibrate as cal
atlas=cal.load_atlas('96'); guide=json.load(open('data/96/geometry.json')); profile=cal.load_profile('96')
aa=cal.aisle_anchors(atlas['geometry']['anchors']); ga=cal.aisle_anchors(guide['anchors'])
# Generate exact config-style range pins with swapped axes.
def candidates(axis, source):
 out=[]
 for a0 in sorted(aa):
  for a1 in sorted(aa):
   if a1<=a0: continue
   for g0 in sorted(ga):
    shift=g0-a0
    pts=[(aa[n][source],ga[n+shift][axis],n) for n in range(a0,a1+1) if n in aa and n+shift in ga]
    if len(pts)<2: continue
    fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1)
    res=max(abs(fit[0]*p[0]+fit[1]-p[1]) for p in pts)
    if res>cal.TOL_PT or not cal.SCALE_BAND[0]<=abs(fit[0])<=cal.SCALE_BAND[1]: continue
    out.append({'axis':axis,'source':source,'a':[a0,a1],'g':[g0,g0+shift*(0) + (a1-a0)],'shift':shift,'scale':float(fit[0]),'offset':float(fit[1]),'res':float(res),'points':len(pts),'inliers':[p[2] for p in pts]})
 return out
xs=candidates(0,1); ys=candidates(1,0)
print('candidate counts',len(xs),len(ys))
# unique by transform approximately
pairs=[]; scorer=cal.floor_scorer(profile,atlas['psas'])
for x,y in itertools.product(xs,ys):
 if abs(abs(x['scale']/y['scale'])-1)>cal.MAX_SKEW: continue
 xr={'scale':x['scale'],'offset':x['offset'],'source_axis':1,'max_residual_pt':round(x['res'],3),'inliers':x['inliers'],'aisle_offset':x['shift'],'pinned':True}
 yr={'scale':y['scale'],'offset':y['offset'],'source_axis':0,'max_residual_pt':round(y['res'],3),'inliers':y['inliers'],'aisle_offset':y['shift'],'pinned':True}
 rec={'x':xr,'y':yr}
 if not cal._footprint_ok((xr,yr),atlas['geometry'],guide): continue
 score=scorer(rec)
 pairs.append((score,x,y,rec))
print('pairs',len(pairs))
for score,x,y,rec in sorted(pairs,key=lambda z:(z[0],len(z[1]['inliers'])+len(z[2]['inliers'])),reverse=True)[:80]:
 print('score',round(score,4),'x',x['a'],x['shift'],round(x['scale'],4),round(x['offset'],1),'y',y['a'],y['shift'],round(y['scale'],4),round(y['offset'],1),'pts',x['points'],y['points'])
