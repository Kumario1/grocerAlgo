atlas=cal.load_atlas('96'); guide=json.load(open('data/96/geometry.json')); profile=cal.load_profile('96'); base=cal.calibrate('96')
score=cal.floor_scorer(profile,atlas['psas']); runs=cal.shelf_runs(atlas['psas'])
con=sqlite3.connect('runtime/onboarding-96/heb.sqlite'); placements=[json.loads(v) for _,v in con.execute(\"select cache_key,value_json from cache where kind='placement'\")]
def labels(x):
 rec={'x':x,'y':base['y']}; carry=cal.transform(rec); a=0; details=[]
 for p in placements:
  seg=cli.corridor_segment(atlas['psas'],runs,p['group'],p['point']); got,ok=cli.aisle_agreement(guide['anchors'],cal.guide_aisle_name({},int(p['location_label'].split()[-1])),[carry(q) for q in seg]); a+=ok; details.append(got.replace('AISLE ',''))
 return a,','.join(details)
for scale in (-1.3725151494641767,-1.40,-1.42,-1.44,-1.4492542466447675):
