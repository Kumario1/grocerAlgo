   if a1<=a0: continue
   for g0 in sorted(ga):
    sh=g0-a0; g1=a1+sh
    if g1 not in ga: continue
    pts=[(aa[n][source],ga[n+sh][axis],n) for n in range(a0,a1+1) if n in aa and n+sh in ga]
    if len(pts)<2: continue
    fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1); res=max(abs(fit[0]*p[0]+fit[1]-p[1]) for p in pts)
    if res>cal.TOL_PT or not cal.SCALE_BAND[0]<=abs(fit[0])<=cal.SCALE_BAND[1]: continue
    scale,offset=map(float,fit)
    key=(round(scale,8),round(offset,8))
    if key in seen: continue
    seen.add(key)
    out.append({'scale':scale,'offset':offset,'config':(a0,a1,sh,len(pts),round(res,3))})
 return out
