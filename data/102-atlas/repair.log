import json
from pathlib import Path
from router import calibrate as c
A=json.loads(Path('data/102-atlas/geometry.json').read_text()); G=json.loads(Path('data/102/geometry.json').read_text()); P=json.loads(Path('data/102-atlas/psas.json').read_text())
profile=c.load_profile('102'); floor=c.floor_scorer(profile,P); AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
def pins(axis, groups, shifts):
 out=[]
 for a0 in groups:
  for a1 in groups:
   if a1<=a0: continue
   for sh in shifts:
    if a0+sh not in GG or a1+sh not in GG: continue
    p=c._pinned(AA,GG,{'atlas':[a0,a1],'guide':[a0+sh,a1+sh]},axis,axis)
    if p['max_residual_pt']<=3 and .2<=abs(p['scale'])<=5: out.append((a0,a1,sh,p))
 return out
xs=pins(0,range(3,17),range(-1,2)); ys=pins(1,range(17,33),range(-1,1))
rows=[]
for a0,a1,shx,x in xs:
 for b0,b1,shy,y in ys:
  if not c._skew_ok(x,y): continue
  rec={'x':x,'y':y}; fc=c.floor_check(profile,rec,P)
  rows.append((fc['on_floor_pct'],a0,a1,shx,b0,b1,shy,x,y,fc))
rows.sort(key=lambda r:(-r[0],max(r[8]['max_residual_pt'],r[7]['max_residual_pt'])))
print('counts',len(xs),len(ys),'pairs',len(rows))
for pct,a0,a1,shx,b0,b1,shy,x,y,fc in rows[:100]:
 print('pct %.2f x[%d,%d]sh%+d r%.2f y[%d,%d]sh%+d r%.2f sc %.4f/%.4f off %.1f/%.1f keys %s'%(pct,a0,a1,shx,x['max_residual_pt'],b0,b1,shy,y['max_residual_pt'],x['scale'],y['scale'],x['offset'],y['offset'],[k for k,_ in fc['off_floor'][:2]]))
