import json, warnings
from pathlib import Path
from router import calibrate as c
import numpy as np
warnings.simplefilter('ignore', np.RankWarning)
A=json.loads(Path('data/102-atlas/geometry.json').read_text()); G=json.loads(Path('data/102/geometry.json').read_text()); P=json.loads(Path('data/102-atlas/psas.json').read_text())
profile=c.load_profile('102'); AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
valid={}
for axis,name,src in ((0,'x',0),(1,'y',1)):
  rows=[]
  for a0 in sorted(AA):
    for a1 in sorted(AA):
      if a1<=a0: continue
      for shift in range(-5,6):
        if a0+shift not in GG or a1+shift not in GG: continue
        spec={'atlas':[a0,a1],'guide':[a0+shift,a1+shift]}
        p=c._pinned(AA,GG,spec,axis,src)
        if p['max_residual_pt'] <= c.TOL_PT: rows.append((a0,a1,shift,p))
  valid[name]=rows
floor=c.floor_scorer(profile,P)
found=[]
for a0,a1,shx,x in valid['x']:
  for b0,b1,shy,y in valid['y']:
    if not c._skew_ok(x,y): continue
    rec={'x':x,'y':y}
    found.append((floor(rec),a0,a1,shx,b0,b1,shy,x,y))
found.sort(key=lambda r:(-r[0], max(r[8]['max_residual_pt'],r[9]['max_residual_pt']), -(r[1+1]-r[1])))
print('combined valid',len(found))
for score,a0,a1,shx,b0,b1,shy,x,y in found[:80]:
  fc=c.floor_check(profile,{'x':x,'y':y},P)
  print('floor %.4f %.2f%% pass=%s x %d..%d shift %+d res %.3f y %d..%d shift %+d res %.3f scales %.4f/%.4f off %.1f/%.1f keys=%s' % (score,fc['on_floor_pct'],fc['pass'],a0,a1,shx,x['max_residual_pt'],b0,b1,shy,y['max_residual_pt'],x['scale'],y['scale'],x['offset'],y['offset'],[k for k,_ in fc['off_floor'][:3]]))
