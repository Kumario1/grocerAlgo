import json
from pathlib import Path
from router import calibrate as c
A=json.loads(Path('data/102-atlas/geometry.json').read_text())
G=json.loads(Path('data/102/geometry.json').read_text())
AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
for axis,name,src in ((0,'x',0),(1,'y',1)):
  rows=[]
  nums=sorted(AA)
  for a0 in nums:
    for a1 in nums:
      if a1 <= a0: continue
      for shift in range(-5,6):
        g0,g1=a0+shift,a1+shift
        if g0 not in GG or g1 not in GG: continue
        try: p=c._pinned(AA,GG,{'atlas':[a0,a1],'guide':[g0,g1]},axis,src)
        except Exception: continue
        if p['max_residual_pt'] <= c.TOL_PT:
          rows.append((p['max_residual_pt'],a1-a0,len(p['inliers']),a0,a1,shift,p['scale'],p['offset']))
  rows.sort(key=lambda r:(r[0],-r[1],-r[2]))
  print('\\n'+name,'valid pins',len(rows))
  for r in rows[:80]: print('res %.3f span %2d n%2d atlas %2d..%2d shift %+d scale %.5f off %.2f'%r)
