import json
from pathlib import Path
from router import calibrate as c
A=json.loads(Path('data/102-atlas/geometry.json').read_text()); G=json.loads(Path('data/102/geometry.json').read_text())
AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
for axis,name,src in ((0,'x',0),(1,'y',1)):
  rows=[]
  for a0 in sorted(AA):
    for a1 in sorted(AA):
      if a1<=a0: continue
      for shift in range(-5,6):
        if a0+shift not in GG or a1+shift not in GG: continue
        p=c._pinned(AA,GG,{'atlas':[a0,a1],'guide':[a0+shift,a1+shift]},axis,src)
        if p['max_residual_pt'] <= c.TOL_PT and abs(p['scale']) >= c.SCALE_BAND[0]:
          rows.append((p['max_residual_pt'],a1-a0,len(p['inliers']),a0,a1,shift,p['scale'],p['offset']))
  rows.sort(key=lambda r:(-r[1],r[0],-r[2]))
  print(name,'valid noncollapsed pins',len(rows))
  for r in rows[:100]: print('res %.3f span %2d n%2d atlas %2d..%2d shift %+d scale %.5f off %.2f'%r)
