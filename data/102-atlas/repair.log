            db.execute("""
                CREATE TABLE IF NOT EXISTS cache (
                    kind TEXT NOT NULL,
                    store_id INTEGER NOT NULL,
                    cache_key TEXT NOT NULL,
                    value_json TEXT NOT NULL,
