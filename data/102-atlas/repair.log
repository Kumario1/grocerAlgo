import json
from router import calibrate as c
s='52'; ag=c.load_atlas(s)['geometry']; gg=json.load(open(f'data/{s}/geometry.json')); A=c.aisle_anchors(ag['anchors']);G=c.aisle_anchors(gg['anchors']);p=c.load_profile(s);ps=c.load_atlas(s)['psas']
for pair in [([6,7],[5,6]),([23,24],[22,23])]:
 pass
print('baseline',c.fit(ag,gg, floor=c.floor_scorer(p,ps)))
rows=[]
for xa in sorted(A):
 if xa+1 not in A: continue
 for sx in range(-2,3):
  if xa+sx not in G or xa+1+sx not in G: continue
  try:x=c._pinned(A,G,{'atlas':[xa,xa+1],'guide':[xa+sx,xa+1+sx]},0)
  except:continue
  for ya in sorted(A):
   if ya+1 not in A: continue
   for sy in range(-2,3):
    if ya+sy not in G or ya+1+sy not in G: continue
    try:y=c._pinned(A,G,{'atlas':[ya,ya+1],'guide':[ya+sy,ya+1+sy]},1)
    except:continue
    if not c._skew_ok(x,y):continue
    f=c.floor_check(p,{'x':x,'y':y},ps)
    rows.append((f['on_floor_pct'],xa,sx,ya,sy,x['scale'],y['scale']))
for r in sorted(rows,reverse=True)[:40]:print(r)
PY" in /Users/princekumar/Documents/grocerAlgo
