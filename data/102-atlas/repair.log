codex
The repository’s fleet logs confirm this is the intended repair class: store 52 was repaired with exactly two-aisle `atlas_fit` pins plus a vintage shift, and its normal/live runs then passed. I’m following that convention for 102 now—searching only adjacent, physically aligned aisle pairs, not broad or collapsed fits.
exec
/bin/zsh -lc "./.venv/bin/python3 - <<'PY' 2>/dev/null
import json
from pathlib import Path
from router import calibrate as c
A=json.loads(Path('data/102-atlas/geometry.json').read_text()); G=json.loads(Path('data/102/geometry.json').read_text()); P=json.loads(Path('data/102-atlas/psas.json').read_text())
profile=c.load_profile('102'); AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
def pin(axis,a0,shift):
 return c._pinned(AA,GG,{'atlas':[a0,a0+1],'guide':[a0+shift,a0+1+shift]},axis,axis)
# Physically aligned, adjacent pairs: x horizontal banks; y right-hand vertical bank.
xs=[]
for a0 in list(range(3,16))+list(range(33,42)):
 for sh in (-1,0,1):
  if a0+sh in GG and a0+1+sh in GG:
   p=pin(0,a0,sh)
   if .2<=abs(p['scale'])<=5: xs.append((a0,sh,p))
ys=[]
for a0 in range(17,32):
 for sh in (-1,0,1):
  if a0+sh in GG and a0+1+sh in GG:
   p=pin(1,a0,sh)
   if .2<=abs(p['scale'])<=5: ys.append((a0,sh,p))
floor=c.floor_scorer(profile,P)
rows=[]
for xa,xsh,x in xs:
 for ya,ysh,y in ys:
  if not c._skew_ok(x,y): continue
  rec={'x':x,'y':y}
  score=floor(rec)
  fc=c.floor_check(profile,rec,P)
  rows.append((fc['on_floor_pct'],xa,xsh,ya,ysh,x,y,fc))
rows.sort(key=lambda r:(-r[0],- (r[2]==0),- (r[4]==-1)))
print('candidate counts',len(xs),len(ys),'pairs',len(rows))
for pct,xa,xsh,ya,ysh,x,y,fc in rows[:120]:
 print('floor %.2f pass=%s x %d/%d sh%+d sc%.5f y %d/%d sh%+d sc%.5f off %.1f/%.1f keys=%s'%(pct,fc['pass'],xa,xa+1,xsh,x['scale'],ya,ya+1,ysh,y['scale'],x['offset'],y['offset'],[k for k,_ in fc['off_floor'][:2]]))
