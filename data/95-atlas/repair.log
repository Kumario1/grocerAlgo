import json
from router import calibrate as c
with open('data/95-atlas/geometry.json') as f: atlas=json.load(f)
with open('data/95/geometry.json') as f: guide=json.load(f)
profile=c.load_profile('95')
floor=c.floor_scorer(profile,atlas['psas'])
xs=[((1,13),(1,13)),((1,12),(1,12)),((1,11),(1,11)),((2,13),(2,13)),((1,13),(2,14)),((1,14),(1,14)),((1,14),(2,15))]
ys=[((17,22),(16,21)),((17,24),(16,23)),((18,22),(17,21)),((17,21),(16,20)),((18,23),(17,22)),((19,22),(18,21)),((28,34),(26,32)),((28,33),(26,31)),((28,36),(26,34)),((29,33),(27,31)),((31,33),(29,31)),((31,35),(29,33)),((35,36),(33,34)),((25,26),(24,25)),((26,27),(26,27)),((17,23),(16,22))]
for xa in xs:
  for ya in ys:
    pin={'x':{'atlas':list(xa[0]),'guide':list(xa[1])},'y':{'atlas':list(ya[0]),'guide':list(ya[1])}}
    try:
      rec=c.fit(atlas['geometry'],guide,pin)
      pct=floor(rec)
      passfloor=c.floor_check(profile,rec,atlas['psas'])
      gates={k:(v.get('pass') if isinstance(v,dict) else v) for k,v in rec['gates'].items()}
      if gates.get('scale_skew') and pct >= .99:
        print('PASSLIKE',xa,ya,'scales',round(rec['x']['scale'],4),round(rec['y']['scale'],4),'offsets',round(rec['x']['offset'],1),round(rec['y']['offset'],1),'floor_score',pct,'floorcheck',passfloor['on_floor_pct'],gates,'res',rec['x']['max_residual_pt'],rec['y']['max_residual_pt'])
    except Exception as e:
      print('ERR',xa,ya,e)
print('\\nselected all floor-ranked:')
rows=[]
for xa in xs:
  for ya in ys:
    pin={'x':{'atlas':list(xa[0]),'guide':list(xa[1])},'y':{'atlas':list(ya[0]),'guide':list(ya[1])}}
    try:
      rec=c.fit(atlas['geometry'],guide,pin)
      pct=floor(rec); fc=c.floor_check(profile,rec,atlas['psas'])
      rows.append((pct,rec['gates'].get('scale_skew'),xa,ya,rec['x']['scale'],rec['y']['scale'],fc['on_floor_pct'],rec['x']['max_residual_pt'],rec['y']['max_residual_pt']))
    except: pass
for row in sorted(rows,reverse=True)[:25]:
  pct,sk,xa,ya,sx,sy,fc,rx,ry=row
  print('score %.3f floor %.2f skew %s x%s y%s scales %.4f %.4f res %.3f %.3f'%(pct,fc,sk,xa,ya,sx,sy,rx,ry))
