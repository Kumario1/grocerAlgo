import json
import numpy as np
from router.calibrate import _footprint_ok, _fixture_span
with open('data/95-atlas/geometry.json') as f: a=json.load(f)
with open('data/95/geometry.json') as f: g=json.load(f)
common=sorted(set(a['anchors']) & set(g['anchors']) - {k for k in set(a['anchors'])|set(g['anchors']) if k.startswith('AISLE ')})
print('common named anchors:', common)
for target_axis,name in [(0,'x'),(1,'y')]:
  for source_axis in (0,1):
    pts=[(a['anchors'][k][source_axis],g['anchors'][k][target_axis],k) for k in common]
    fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1)
    residuals=[(abs(fit[0]*s+fit[1]-d), k, s,d, fit[0]*s+fit[1]-d) for s,d,k in pts]
    print(f'{name} <- atlas[{source_axis}]: scale={fit[0]:.6f} offset={fit[1]:.3f} max={max(x[0] for x in residuals):.3f} rmse={np.sqrt(np.mean([x[0]**2 for x in residuals])):.3f}')
    print('  '+' '.join(f'{k}:{err:.1f}' for err,_,_,_,k in []))
    print('  '+', '.join(f'{k}={err:.1f}' for err,k,*_ in sorted(residuals, reverse=True)))
print('raw common anchor pairs')
for k in common: print(k,a['anchors'][k],g['anchors'][k])
print('fixture spans atlas',_fixture_span(a),'guide',_fixture_span(g))
