for shift in range(-5,3):
  rows=[]
  for start in range(15,37):
    for end in range(start+1,37):
      if any(n not in a or n+shift not in g for n in range(start,end+1)): break
      pts=[(a[n][1],g[n+shift][1],n) for n in range(start,end+1)]
