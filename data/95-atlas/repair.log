    if len(sys.argv) < 2:
        raise SystemExit(__doc__)
    store = sys.argv[1]
    record = cal.calibrate(store)

    for note in record["notes"]:
        print(f"    {note}")
    for name in ("x", "y"):
        axis = record.get(name)
        if not axis:
