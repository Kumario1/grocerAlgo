  print('\\nshift %+d'%shift)
  for row in sorted(rows,key=lambda x:(-x[0],x[1]))[:30]: print(' n%d res%.3f A%d-%d G%d-%d scale%.5f off%.2f'% (row[0],row[1],row[2],row[3],row[2]+shift,row[3]+shift,row[4],row[5]))
