import json
import numpy as np
from router import calibrate as c

with open('data/95-atlas/geometry.json') as f: atlas=json.load(f)
with open('data/95/geometry.json') as f: guide=json.load(f)

a=c.aisle_anchors(atlas['anchors'])
g=c.aisle_anchors(guide['anchors'])
print('axis candidates:')
for target_axis, target_name in [(0,'x'),(1,'y')]:
    for source_axis in (target_axis,1-target_axis):
        cs=c.axis_candidates(a,g,target_axis,source_axis,atlas['page'][['w','h'][source_axis]])
        print(f'{target_name} <- atlas[{source_axis}] ({len(cs)} candidates)')
        for v in cs[:12]:
            print(' ', {k:v[k] for k in ('aisle_offset','source_axis','scale','offset','inliers','max_residual_pt')})

print('\\nconstant aisle-offset fits by target axis/source axis:')
for target_axis, target_name in [(0,'x'),(1,'y')]:
    for source_axis in (target_axis,1-target_axis):
        rows=[]
        for shift in range(-10,11):
            pts=[(a[n][source_axis],g[n+shift][target_axis],n) for n in sorted(a) if n+shift in g]
            if len(pts)<2: continue
            fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1)
            residual=max(abs(fit[0]*p[0]+fit[1]-p[1]) for p in pts)
            spread=max(p[0] for p in pts)-min(p[0] for p in pts)
            rows.append((residual,len(pts),shift,fit[0],fit[1],spread))
        for row in sorted(rows)[:8]: print(target_name,source_axis,'resid %.3f n%d shift %+d scale %.5f off %.2f span %.1f'%row)

print('\\nselected physical-range fits:')
def fit_range(axis, source_axis, ar, gr):
    pts=[(a[n][source_axis],g[n+(gr[0]-ar[0])][axis],n) for n in range(ar[0],ar[1]+1) if n in a and n+(gr[0]-ar[0]) in g]
    fit=np.polyfit([p[0] for p in pts],[p[1] for p in pts],1)
    residual=max(abs(fit[0]*p[0]+fit[1]-p[1]) for p in pts)
    return len(pts),fit[0],fit[1],residual, [p[2] for p in pts]
for ar,gr in [((1,15),(1,15)),((1,14),(1,14)),((2,15),(2,15)),((14,16),(14,16)),((15,16),(15,16)),((16,36),(16,34)),((17,35),(16,34)),((18,36),(16,34)),((17,34),(16,33)),((18,35),(16,33)),((19,36),(16,33))]:
    try:
        print('x',ar,gr,fit_range(0,0,ar,gr))
    except Exception as e: print('x',ar,gr,e)
    try:
        print('y',ar,gr,fit_range(1,1,ar,gr))
    except Exception as e: print('y',ar,gr,e)
