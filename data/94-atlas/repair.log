import json, itertools, numpy as np
from router import calibrate as c
A=json.load(open('data/94-atlas/geometry.json')); G=json.load(open('data/94/geometry.json')); psas=json.load(open('data/94-atlas/psas.json'))
AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
profile=c.load_profile('94'); score=c.floor_scorer(profile,psas,sample=0)

def candidates(axis,src=None):
 src=axis if src is None else src; out=[]
 nums=sorted(AA)
 for a0,a1 in itertools.combinations(nums,2):
  if a1-a0<1: continue
  for g0,g1 in itertools.combinations(sorted(GG),2):
   if g1-g0 "'!= a1-a0: continue
   pin={'"'atlas':[a0,a1],'guide':[g0,g1]}
   try: q=c._pinned(AA,GG,pin,axis,src)
   except Exception: continue
   if len(q['inliers'])<2 or not c.SCALE_BAND[0]<=abs(q['scale'])<=c.SCALE_BAND[1]: continue
   out.append(q|{'atlas_range':[a0,a1],'guide_range':[g0,g1]})
 return out
for srcx,srcy in [(0,1),(1,0),(0,0),(1,1)]:
 X=candidates(0,srcx); Y=candidates(1,srcy)
 pairs=[]
 for x in X:
  for y in Y:
   if x['source_axis']==y['source_axis'] or not c._skew_ok(x,y): continue
   landed=score({'x':x,'y':y})
   pairs.append((landed,x,y))
 pairs.sort(key=lambda q:(-q[0],-len(q[1]['inliers'])-len(q[2]['inliers']),max(q[1]['max_residual_pt'],q[2]['max_residual_pt'])))
 print('\\nSRC',srcx,srcy,'cands',len(X),len(Y),'pairs',len(pairs))
 seen=set(); n=0
 for landed,x,y in pairs:
  key=(round(x['scale'],4),round(x['offset'],1),round(y['scale'],4),round(y['offset'],1),tuple(x['atlas_range']),tuple(x['guide_range']),tuple(y['atlas_range']),tuple(y['guide_range']))
  if key in seen: continue
  seen.add(key)
  print(f'{landed:.4f}', 'x',x['atlas_range'],'->',x['guide_range'],f's={x[\"scale\"]:.4f} o={x[\"offset\"]:.1f}', 'y',y['atlas_range'],'->',y['guide_range'],f's={y[\"scale\"]:.4f} o={y[\"offset\"]:.1f}')
  n+=1
  if n>=20: break
