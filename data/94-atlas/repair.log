import json
from pathlib import Path
from PIL import Image, ImageDraw, ImageFont
A=json.loads(Path('data/94-atlas/geometry.json').read_text()); G=json.loads(Path('data/94/geometry.json').read_text())
font=None
for name,geom,out in [('atlas',A,'/private/tmp/atlas94-geom.png'),('guide',G,'/private/tmp/guide94-geom.png')]:
 W,H=map(int,(geom['page']['w'],geom['page']['h']))
 s=1.5
 im=Image.new('RGB',(int(W*s),int(H*s)),'white'); d=ImageDraw.Draw(im)
 def pp(p): return (round(p[0]*s),round(p[1]*s))
 for x1,y1,x2,y2 in geom.get('fixtures',[]):
  d.rectangle((round(x1*s),round(y1*s),round(x2*s),round(y2*s)),fill=(70,70,70))
 for p in geom.get('fixture_polys',[]): d.polygon([pp(x) for x in p],fill=(110,110,110))
 for name,p in geom.get('anchors',{}).items():
  if str(name).startswith('AISLE '):
   q=pp(p); d.ellipse((q[0]-6,q[1]-6,q[0]+6,q[1]+6),fill='red')
   d.text((q[0]+8,q[1]-8),str(name).replace('AISLE ',''),fill='blue',font=font)
  elif name in {'DAIRY','PHARMACY','CHECKSTANDS','ENTRANCE','PRODUCE','BAKERY','DELI','FLORAL','SEAFOOD'}:
   q=pp(p); d.ellipse((q[0]-5,q[1]-5,q[0]+5,q[1]+5),fill='green'); d.text((q[0]+7,q[1]),name,fill='green',font=font)
 im.save(out)
 print(out,im.size)
