import json, numpy as np
from scipy.optimize import differential_evolution, shgo, minimize
from router import calibrate as c
atlas=c.load_atlas('94'); profile=c.load_profile('94')
score=c.floor_scorer(profile,atlas['psas'],sample=400)
# The calibrator's y-derived model is exactly this 3-variable family: common scale, x/y offsets.
def f(v):
 s,ox,oy=v
 a={'scale':s,'offset':ox,'source_axis':0}
 b={'scale':s,'offset':oy,'source_axis':1}
 return -score({'x':a,'y':b})
for seed in range(5):
 res=differential_evolution(f,[(.8,1.6),(-400,400),(-200,250)],seed=seed,popsize=10,maxiter=80,tol=1e-7,polish=True,workers=1)
 print(seed,res.fun,res.x)
 # exact score
 s,ox,oy=res.x
 print(' exact',-c.floor_scorer(profile,atlas['psas'],sample=0)({'x':{'scale':s,'offset':ox,'source_axis':0},'y':{'scale':s,'offset':oy,'source_axis':1}}))
