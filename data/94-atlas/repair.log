  fc=c.floor_check(profile,rec,P)
  print('FULL',round(fc['on_floor_pct'],2),fc['pass'],'y',[a,b],'->',[g,h],'s/o',round(ys,4),round(yo,1),'off',fc['off_floor'][:2])
