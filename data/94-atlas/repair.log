import json,itertools,warnings
warnings.filterwarnings('ignore')
import numpy as np
from router import calibrate as c
A=json.load(open('data/94-atlas/geometry.json'));G=json.load(open('data/94/geometry.json'));P=json.load(open('data/94-atlas/psas.json'))
AA=c.aisle_anchors(A['anchors']);GG=c.aisle_anchors(G['anchors']); profile=c.load_profile('94')

def candidates(axis,src):
 out=[]
 for a0,a1 in itertools.combinations(sorted(AA),2):
  for g0 in sorted(GG):
   g1=g0+(a1-a0)
   if g1 not in GG:continue
   q=c._pinned(AA,GG,{'atlas':[a0,a1],'guide':[g0,g1]},axis,src)
   if c.SCALE_BAND[0]<=abs(q['scale'])<=c.SCALE_BAND[1] and q['max_residual_pt']<=c.TOL_PT:
    out.append(q|{'ar':[a0,a1],'gr':[g0,g1]})
 return out
X=candidates(0,0);Y=candidates(1,1)
# replicate scorer sample=400 exactly
free,reach,cell,_=profile; away=c.floor_map(profile); runs=c.shelf_runs(P); keys=list(P); step=max(1,len(keys)//400);keys=keys[::step]
pts=np.asarray([c.to_corridor(runs,f\"PSA:{k.split('|',2)[0]}:{k.split('|',2)[1]}\",P[k]) for k in keys])
height,width=free.shape
# only y candidates with positive/negative, pair by scale skew
ys=np.array([q['scale'] for q in Y]); yo=np.array([q['offset'] for q in Y]); ysrc=np.array([q['source_axis'] for q in Y]);
res=[]
for ix,x in enumerate(X):
  sx=x['scale'];
  ok=np.abs(np.abs(sx/ys)-1)<=c.MAX_SKEW
  inds=np.nonzero(ok & (ysrc"'!=x['"'source_axis']))[0]
  if not len(inds):continue
  xp=(sx*pts[:,0]+x['offset'])//cell
  # (M,N), clip indices only after inside mask
  for start in range(0,len(inds),256):
    ii=inds[start:start+256]
    yp=(ys[ii,None]*pts[:,1]+yo[ii,None])//cell
    cx=np.broadcast_to(xp,(len(ii),len(pts))).astype(int)
    cy=yp.astype(int)
    inside=(cx>=0)&(cx<width)&(cy>=0)&(cy<height)
    vals=np.zeros_like(inside,dtype=bool)
    vals[inside]=away[cy[inside],cx[inside]]<=c.MAX_SNAP_M
    frac=vals.mean(axis=1)
    for j,f in zip(ii,frac):res.append((float(f),x,Y[j]))
res.sort(key=lambda z:(-z[0],-len(z[1]['inliers'])-len(z[2]['inliers']),max(z[1]['max_residual_pt'],z[2]['max_residual_pt'])))
print('counts',len(X),len(Y),'pairs',len(res))
for f,x,y in res[:50]:
 print(f'{f:.4f} x {x[\"ar\"]}->{x[\"gr\"]} s/o {x[\"scale\"]:.5f}/{x[\"offset\"]:.2f}; y {y[\"ar\"]}->{y[\"gr\"]} s/o {y[\"scale\"]:.5f}/{y[\"offset\"]:.2f}; res {x[\"max_residual_pt\"]}/{y[\"max_residual_pt\"]}')
print('\\nfull top 20')
for f,x,y in res[:20]:
 fc=c.floor_check(profile,{'x':x,'y':y},P)
 print(f'{fc[\"on_floor_pct\"]:.2f}% {fc[\"pass\"]} sample={f:.4f} x {x[\"ar\"]}->{x[\"gr\"]} y {y[\"ar\"]}->{y[\"gr\"]} s/o {x[\"scale\"]:.5f}/{x[\"offset\"]:.2f};{y[\"scale\"]:.5f}/{y[\"offset\"]:.2f}')
