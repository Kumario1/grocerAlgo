import json, itertools, numpy as np, sys
from pathlib import Path
sys.path.insert(0,'.')
from router.calibrate import aisle_anchors, _pinned
A=json.loads(Path('data/94-atlas/geometry.json').read_text()); G=json.loads(Path('data/94/geometry.json').read_text())
aa=aisle_anchors(A['anchors']); ga=aisle_anchors(G['anchors'])
for axis,name in [(0,'x'),(1,'y')]:
 print('\\nAXIS',name)
 out=[]
 for shift in range(-50,51):
  ns=sorted(n for n in aa if n+shift in ga)
  # all contiguous subranges of available n, but preserve any missing weird
  for i,a0 in enumerate(ns):
   for a1 in ns[i+1:]:
    ns2=[n for n in ns if a0<=n<=a1]
    if len(ns2)<2: continue
    xs=np.array([aa[n][axis] for n in ns2]); ys=np.array([ga[n+shift][axis] for n in ns2])
    s,o=np.polyfit(xs,ys,1); r=max(abs(s*xs+o-ys))
    if r<=3:
     out.append((len(ns2),r,abs(s),s,o,shift,a0,a1,ns2))
 out.sort(key=lambda z:(-z[0],z[1],abs(z[2]-1)))
 for z in out[:60]:
  l,r,ab,s,o,sh,a0,a1,ns2=z
  print(f'n={l:2} res={r:5.2f} s={s:8.5f} o={o:8.2f} shift={sh:+3} range={a0}-{a1} nums={ns2}')
