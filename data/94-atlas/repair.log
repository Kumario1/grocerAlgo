S=2; shape=(H*S,W*S)
def poly_mask(geom,tx=None):
    m=np.zeros(shape,np.uint8)
    polys=[]
    for x1,y1,x2,y2 in geom.get('fixtures',[]):
      polys.append([[x1,y1],[x2,y1],[x2,y2],[x1,y2]])
    polys += geom.get('fixture_polys',[])
    for p in polys:
      q=np.asarray(p,float)
      if tx:
       q=np.column_stack([tx[0]*q[:,0]+tx[1],tx[2]*q[:,1]+tx[3]])
      q=np.rint(q*S).astype(np.int32)
      cv2.fillPoly(m,[q],1)
    return m
