   for g in sorted(GG):
    h=g+(b-a)
    if h not in GG: continue
    try:y=c._pinned(AA,GG,{'atlas':[a,b],'guide':[g,h]},1)
    except:continue
    if not c._skew_ok(x,y):continue
    rows.append((score({'x':x,'y':y}),a,b,g,h,y['scale'],y['offset']))
 rows.sort(reverse=True)
