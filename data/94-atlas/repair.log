import json,itertools
from router import calibrate as c
A=json.load(open('data/94-atlas/geometry.json'));G=json.load(open('data/94/geometry.json'));P=json.load(open('data/94-atlas/psas.json'))
AA=c.aisle_anchors(A['anchors']);GG=c.aisle_anchors(G['anchors']);profile=c.load_profile('94')
for xr in ([1,15],[5,15],[5,6],[1,2]):
 x=c._pinned(AA,GG,{'atlas':xr,'guide':[xr[0]+1,xr[1]+1] if xr[0]==1 else [xr[0]-4,xr[1]-4]},0)
 # use sampled score
 score=c.floor_scorer(profile,P,sample=400)
 rows=[]
 for a in sorted(AA):
  for b in sorted(AA):
   if b<=a: continue
   # only two real aisle anchors per user/runbook; try all span lengths, but cap 15
