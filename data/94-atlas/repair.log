/bin/zsh -lc "python3 - <<'PY'
import json,numpy as np
from pathlib import Path
from router.calibrate import aisle_anchors
A=json.loads(Path('data/94-atlas/geometry.json').read_text()); G=json.loads(Path('data/94/geometry.json').read_text())
aa=aisle_anchors(A['anchors']); ga=aisle_anchors(G['anchors'])
for axis,name,extent in [(0,'x',A['page']['w']),(1,'y',A['page']['h'])]:
 print('\\nAXIS',name)
 out=[]
 for sh in range(-50,51):
  ns=sorted(n for n in aa if n+sh in ga)
  for i,a0 in enumerate(ns):
   for a1 in ns[i+1:]:
    n2=[n for n in ns if a0<=n<=a1]
    xs=np.array([aa[n][axis] for n in n2]); ys=np.array([ga[n+sh][axis] for n in n2])
    spread=max(xs)-min(xs)
    if spread < .25*extent: continue
    s,o=np.polyfit(xs,ys,1); res=max(abs(s*xs+o-ys))
    if res<=3 and .2<=abs(s)<=5:
      out.append((len(n2),spread,res,s,o,sh,a0,a1,n2))
 out.sort(key=lambda z:(-z[0],z[2],-z[1]))
 for z in out[:100]: print(f'n={z[0]:2} spread={z[1]:6.1f} res={z[2]:.3f} s={z[3]:.6f} o={z[4]:8.2f} shift={z[5]:+3} range={z[6]}-{z[7]} nums={z[8]}')
