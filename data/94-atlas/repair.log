AA=c.aisle_anchors(A['anchors']); GG=c.aisle_anchors(G['anchors'])
profile=c.load_profile('94'); score=c.floor_scorer(profile,psas,sample=0)

def candidates(axis,src):
 out=[]
 for a0,a1 in itertools.combinations(sorted(AA),2):
  for g0,g1 in itertools.combinations(sorted(GG),2):
   if g1-g0 "'!= a1-a0: continue
   try:q=c._pinned(AA,GG,{'"'atlas':[a0,a1],'guide':[g0,g1]},axis,src)
   except:continue
   if len(q['inliers'])>=2 and c.SCALE_BAND[0]<=abs(q['scale'])<=c.SCALE_BAND[1]: out.append(q|{'atlas_range':[a0,a1],'guide_range':[g0,g1]})
 return out
for srcx,srcy in [(0,1),(1,0)]:
