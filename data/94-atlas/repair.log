AA=c.aisle_anchors(A['anchors']);GG=c.aisle_anchors(G['anchors']); profile=c.load_profile('94')
def candidates(axis,src):
 out=[]
 for a0,a1 in itertools.combinations(sorted(AA),2):
  for g0 in sorted(GG):
   g1=g0+(a1-a0)
   if g1 not in GG:continue
   q=c._pinned(AA,GG,{'atlas':[a0,a1],'guide':[g0,g1]},axis,src)
   if c.SCALE_BAND[0]<=abs(q['scale'])<=c.SCALE_BAND[1] and q['max_residual_pt']<=c.TOL_PT:
    q=q|{'ar':[a0,a1],'gr':[g0,g1]}
    out.append(q)
 return out
X=[q for q in candidates(0,0) if abs(AA[q['ar'][1]][0]-AA[q['ar'][0]][0])>=c.MIN_SPREAD*A['page']['w']]
Y=[q for q in candidates(1,1) if abs(AA[q['ar'][1]][1]-AA[q['ar'][0]][1])>=c.MIN_SPREAD*A['page']['h']]
free,reach,cell,_=profile;away=c.floor_map(profile);runs=c.shelf_runs(P);keys=list(P);keys=keys[::max(1,len(keys)//400)];pts=np.asarray([c.to_corridor(runs,f\"PSA:{k.split('|',2)[0]}:{k.split('|',2)[1]}\",P[k]) for k in keys]);height,width=free.shape
res=[]
for x in X:
 ys=np.array([q['scale'] for q in Y]);ok=(np.abs(np.abs(x['scale']/ys)-1)<=c.MAX_SKEW)&np.array([q['source_axis']"'!=x['"'source_axis'] for q in Y]);
 for y in np.asarray(Y,dtype=object)[ok]:
  sx=x['scale']; cx=((sx*pts[:,0]+x['offset'])//cell).astype(int);cy=((y['scale']*pts[:,1]+y['offset'])//cell).astype(int);inside=(cx>=0)&(cx<width)&(cy>=0)&(cy<height);land=np.zeros(len(pts),bool);land[inside]=away[cy[inside],cx[inside]]<=c.MAX_SNAP_M;res.append((land.mean(),x,y))
res.sort(key=lambda q:-q[0]);print('counts',len(X),len(Y),len(res))
for f,x,y in res[:60]:print(f'{f:.4f} x{x[\"ar\"]}->{x[\"gr\"]} s/o{x[\"scale\"]:.4f}/{x[\"offset\"]:.1f} y{y[\"ar\"]}->{y[\"gr\"]} s/o{y[\"scale\"]:.4f}/{y[\"offset\"]:.1f}')
print('full')
for f,x,y in res[:30]:
