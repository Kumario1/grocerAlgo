import json,itertools,collections
from router import calibrate as c
A=json.load(open('data/94-atlas/geometry.json'));G=json.load(open('data/94/geometry.json'))
AA=c.aisle_anchors(A['anchors']);GG=c.aisle_anchors(G['anchors'])

def candidates(axis,src):
 out=[]
 for a0,a1 in itertools.combinations(sorted(AA),2):
  for g0 in sorted(GG):
   sh=g0-a0; g1=g0+(a1-a0)
   if g1 not in GG:continue
   try:q=c._pinned(AA,GG,{'atlas':[a0,a1],'guide':[g0,g1]},axis,src)
   except:continue
   if c.SCALE_BAND[0]<=abs(q['scale'])<=c.SCALE_BAND[1] and q['max_residual_pt']<=c.TOL_PT:
    out.append(q|{'ar':[a0,a1],'gr':[g0,g1]})
 return out
for axis,src in [(0,0),(1,1),(0,1),(1,0)]:
 q=candidates(axis,src)
 print('axis/src',axis,src,'n',len(q),'unique',len(set((round(x['scale'],7),round(x['offset'],7)) for x in q)))
 # long / all interesting
 for x in sorted(q,key=lambda x:(-(x['ar'][1]-x['ar'][0]),x['max_residual_pt']))[:40]:
  print(x['ar'],x['gr'],'s/o',round(x['scale'],5),round(x['offset'],2),'res',x['max_residual_pt'])
