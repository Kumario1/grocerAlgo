import json, numpy as np
from router.calibrate import aisle_anchors, TOL_PT
A=aisle_anchors(json.load(open('data/94-atlas/geometry.json'))['anchors'])
G=aisle_anchors(json.load(open('data/94/geometry.json'))['anchors'])
print('atlas', sorted(A))
print('guide', sorted(G))
for axis,name in [(0,'x'),(1,'y')]:
  for source,name2 in [(0,'atlas x'),(1,'atlas y')]:
    rows=[]
    for sh in range(-35,36):
      ps=[(A[n][source],G[n+sh][axis],n) for n in A if n+sh in G]
      if len(ps)<2: continue
      fit=np.polyfit([p[0] for p in ps],[p[1] for p in ps],1)
      resid=np.abs(fit[0]*np.array([p[0] for p in ps])+fit[1]-np.array([p[1] for p in ps]))
      inl=int(np.sum(resid<=TOL_PT))
      rows.append((inl,float(resid.max()),float(np.median(resid)),float(fit[0]),sh,len(ps),[p[2] for p,r in zip(ps,resid) if r<=TOL_PT]))
    rows.sort(key=lambda x:(-x[0],x[1],x[2]))
    print('\\n',name,'from',name2)
    for row in rows[:12]: print(row)
