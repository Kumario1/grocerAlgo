}
for name,(sx,ox,sy,oy) in transforms.items():
 Q=A*np.array([sx,sy])+[ox,oy]
 d1=tg.query(Q,k=1)[0]
 # guide to inverse transformed atlas
 R=(G-[ox,oy])/np.array([sx,sy]); d2=ta.query(R,k=1)[0]
 print(name,'A->G q',np.quantile(d1,[.25,.5,.75,.9,.95,.99]),'G->A',np.quantile(d2,[.25,.5,.75,.9,.95,.99]),'mean',d1.mean(),d2.mean(),'lt5',np.mean(d1<5),np.mean(d2<5))
