import json,numpy as np
from scipy.spatial import cKDTree

def pts(g):
 out=[]
 for r in g.get('fixtures',[]) or []:
  x1,y1,x2,y2=r
  # sample rectangle perimeter and endpoints; fixtures perhaps line segments
  for a,b in [((x1,y1),(x2,y1)),((x2,y1),(x2,y2)),((x2,y2),(x1,y2)),((x1,y2),(x1,y1))]:
   n=max(2,int(np.hypot(b[0]-a[0],b[1]-a[1])/2))
   out.extend((np.array(a)*(1-t)+np.array(b)*t).tolist() for t in np.linspace(0,1,n))
 for poly in g.get('fixture_polys',[]) or []:
  for a,b in zip(poly,poly[1:]+poly[:1]):
   a=np.array(a);b=np.array(b);n=max(2,int(np.linalg.norm(b-a)/2));out.extend((a*(1-t)+b*t).tolist() for t in np.linspace(0,1,n))
 return np.asarray(out)
A=pts(json.load(open('data/94-atlas/geometry.json')));G=pts(json.load(open('data/94/geometry.json')))
print(A.shape,G.shape)
ta=cKDTree(A);tg=cKDTree(G)
transforms={
 'baseline':(1.25,-191.66,1.25,-15),
