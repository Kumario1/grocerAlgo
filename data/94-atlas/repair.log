import json, numpy as np
from scipy.spatial import cKDTree

def points(g):
  out=[]
  for r in g.get('fixtures',[]) or []:
    x1,y1,x2,y2=r
    out += [[x1,y1],[x2,y2],[(x1+x2)/2,y1],[(x1+x2)/2,y2],[x1,(y1+y2)/2],[x2,(y1+y2)/2]]
  for poly in g.get('fixture_polys',[]) or []:
    q=np.asarray(poly,float)
    out.extend(q.tolist())
    for a,b in zip(q,np.roll(q,-1,axis=0)):
      for t in np.linspace(.2,.8,4): out.append((a*(1-t)+b*t).tolist())
  return np.asarray(out)
A=points(json.load(open('data/94-atlas/geometry.json')))
G=points(json.load(open('data/94/geometry.json')))
print(A.shape,G.shape)
tree=cKDTree(G)
def score(sx,sy,ox,oy):
  q=A*np.array([sx,sy])+[ox,oy]
  d=tree.query(q,k=1)[0]
  return np.quantile(d,[.5,.75,.9,.95,.99]),np.mean(d<5),np.mean(d<10)
for yoff in [-100,-50,-15,0,30,50,80,100,130,160,200]:
 print('yoff',yoff,score(1.25,1.25,-191.6595,yoff))
