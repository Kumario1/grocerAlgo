import json, numpy as np, warnings
from router import calibrate as cal
warnings.filterwarnings('ignore')
with open('data/92-atlas/geometry.json') as f: ag=json.load(f)
with open('data/92/geometry.json') as f: gg=json.load(f)
with open('data/92-atlas/psas.json') as f: ps=json.load(f)
A=cal.aisle_anchors(ag['anchors']);G=cal.aisle_anchors(gg['anchors'])
def enum(src,tgt,sl,sh,offlo,offhi):
 out=[]; nums=sorted(A)
 for i,a0 in enumerate(nums):
  for a1 in nums[i+1:]:
   span=a1-a0
   for g0 in range(1,61-span):
    g1=g0+span
    if g0 not in G or g1 not in G: continue
    ns=[n for n in range(a0,a1+1) if n in A and n+(g0-a0) in G]
    if len(ns)<2: continue
    x=np.array([A[n][src] for n in ns]); y=np.array([G[n+g0-a0][tgt] for n in ns])
    xb=x.mean();yb=y.mean();den=np.sum((x-xb)**2)
    if den<1e-8: continue
    s=np.sum((x-xb)*(y-yb))/den;o=yb-s*xb
    if not(sl<=s<=sh and offlo<=o<=offhi): continue
    r=float(np.max(np.abs(s*x+o-y)))
    if r<=3: out.append({'scale':float(s),'offset':float(o),'inliers':ns,'aisle_offset':g0-a0,'source_axis':src,'pinned':True,'max_residual_pt':round(r,3),'pin':{'atlas':[a0,a1],'guide':[g0,g1]}})
 return out
xs=enum(0,0,.72,.79,-100,300); ys=enum(1,1,.72,.79,50,210)
profile=cal.load_profile('92');sc=cal.floor_scorer(profile,ps)
rank=[]
for x in xs:
 for y in ys:
  if abs(x['scale']/y['scale']-1)>.05:continue
  if len(x['inliers'])<3 or len(y['inliers'])<3:continue
  rank.append((sc({'x':x,'y':y}),len(x['inliers'])+len(y['inliers']),x,y))
rank.sort(key=lambda q:(q[0],q[1]),reverse=True)
print('counts',len(xs),len(ys),'pairs',len(rank))
# print best by x pin, and best by y pin
seenx=set(); seeny=set()
for score,n,x,y in rank:
 key=tuple(x['pin']['atlas']+x['pin']['guide'])
 if key not in seenx and len(seenx)<40:
  seenx.add(key);print(f\"X score{score:.5f} n{n} sx{x['scale']:.5f} ox{x['offset']:.1f} {x['pin']} y sy{y['scale']:.5f} oy{y['offset']:.1f} {y['pin']}\")
print('--- best y unique')
for score,n,x,y in rank:
 key=tuple(y['pin']['atlas']+y['pin']['guide'])
 if key not in seeny and len(seeny)<40:
  seeny.add(key);print(f\"Y score{score:.5f} n{n} sy{y['scale']:.5f} oy{y['offset']:.1f} {y['pin']} x sx{x['scale']:.5f} ox{x['offset']:.1f} {x['pin']}\")
print('--- score>=.99')
for score,n,x,y in rank:
 if score<.99:break
 if n>=8:
  print(f\"{score:.5f} n{n} x {x['pin']} s{x['scale']:.5f} o{x['offset']:.1f} y {y['pin']} s{y['scale']:.5f} o{y['offset']:.1f}\")
