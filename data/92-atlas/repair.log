/bin/zsh -lc "python3 - <<'PY'
import json, numpy as np, warnings
from router import calibrate as cal
warnings.filterwarnings('ignore')
with open('data/92-atlas/geometry.json') as f: ag=json.load(f)
with open('data/92/geometry.json') as f: gg=json.load(f)
with open('data/92-atlas/psas.json') as f: ps=json.load(f)
A=cal.aisle_anchors(ag['anchors']); G=cal.aisle_anchors(gg['anchors'])

def enum(src,tgt,offlo,offhi):
 out=[]; nums=sorted(A)
 for i,a0 in enumerate(nums):
  for a1 in nums[i+1:]:
   span=a1-a0
   for g0 in range(1,61-span):
    g1=g0+span
    if g0 not in G or g1 not in G: continue
    ns=[n for n in range(a0,a1+1) if n in A and n+(g0-a0) in G]
    if len(ns)<2: continue
    x=np.array([A[n][src] for n in ns]); y=np.array([G[n+g0-a0][tgt] for n in ns])
    # stable least squares
    xbar=x.mean(); ybar=y.mean(); den=np.sum((x-xbar)**2)
    if den < 1e-8: continue
    slope=np.sum((x-xbar)*(y-ybar))/den; off=ybar-slope*xbar
    if not (0.68<=slope<=0.85 and offlo<=off<=offhi): continue
    resid=float(np.max(np.abs(slope*x+off-y)))
    if resid<=3:
      out.append({'scale':float(slope),'offset':float(off),'inliers':ns,'aisle_offset':g0-a0,'source_axis':src,'pinned':True,'max_residual_pt':round(resid,3),'pin':{'atlas':[a0,a1],'guide':[g0,g1]}})
 # de-dup exact transform but retain widest support/short residual
 return out
xs=enum(0,0,-150,300); ys=enum(1,1,50,250)
print('candidate counts',len(xs),len(ys))
# compare scales before floor
pairs=[]
for x in xs:
 for y in ys:
  if abs(abs(x['scale']/y['scale'])-1)>0.05: continue
  pairs.append((x,y))
print('skew pairs',len(pairs))
profile=cal.load_profile('92'); sc=cal.floor_scorer(profile,ps)
rank=[]
for x,y in pairs:
 score=sc({'x':x,'y':y})
 rank.append((score,len(x['inliers'])+len(y['inliers']),-max(x['max_residual_pt'],y['max_residual_pt']),x,y))
rank.sort(reverse=True,key=lambda q:(q[0],q[1],q[2]))
for score,n,res,x,y in rank[:100]:
 print(f\"floor {score:.5f} n{n} sx{x['scale']:.5f} ox{x['offset']:.2f} x{x['pin']} sy{y['scale']:.5f} oy{y['offset']:.2f} y{y['pin']} rx{x['max_residual_pt']:.2f} ry{y['max_residual_pt']:.2f}\")
