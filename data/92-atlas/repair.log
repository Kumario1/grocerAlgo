A=json.load(open('data/92-atlas/geometry.json')); G=json.load(open('data/92/geometry.json'))
def esc(s): return html.escape(str(s),quote=True)
def segs(d,t=lambda p:p):
 out=[]
 for s in d.get('fixtures',[]): out.append((t((s[0],s[1])),t((s[2],s[3]))))
 for poly in d.get('fixture_polys',[]):
  for a,b in zip(poly,poly[1:]+poly[:1]): out.append((t(tuple(a)),t(tuple(b))))
 return out

def overlay(name,sx,ox,sy,oy):
 t=lambda p:(sx*p[0]+ox,sy*p[1]+oy)
 elems=['<svg xmlns=\"http://www.w3.org/2000/svg\" width=\"1224\" height=\"792\" viewBox=\"250 40 970 690\">', '<rect x=\"250\" y=\"40\" width=\"970\" height=\"690\" fill=\"white\"/>']
