from router import calibrate as cal
from calibrate import corridor_segment, label_fits_segment, nearest_aisle
warnings.filterwarnings('ignore')
Ageom=json.load(open('data/92-atlas/geometry.json')); Ggeom=json.load(open('data/92/geometry.json')); P=json.load(open('data/92-atlas/psas.json'))
A=cal.aisle_anchors(Ageom['anchors']); G=cal.aisle_anchors(Ggeom['anchors']); runs=cal.shelf_runs(P)
# unique live probes in cache, preserve numeric source labels
con=sqlite3.connect('/private/tmp/store92-heb.sqlite'); live={}
for _,val in con.execute(\"select cache_key,value_json from cache where kind='placement'\"):
 v=json.loads(val); n=int(v['location_label'].split()[-1]); live[n]=(v['group'],v['point'])
print('live',live.keys())

def enum(src,tgt,sl,sh,offlo,offhi):
 out=[]; nums=sorted(A)
 for i,a0 in enumerate(nums):
  for a1 in nums[i+1:]:
   span=a1-a0
   for g0 in range(1,61-span):
    g1=g0+span
    if g0 not in G or g1 not in G: continue
    ns=[n for n in range(a0,a1+1) if n in A and n+(g0-a0) in G]
    if len(ns)<2: continue
    x=np.array([A[n][src] for n in ns]); y=np.array([G[n+g0-a0][tgt] for n in ns])
    xb=x.mean();yb=y.mean(); den=np.sum((x-xb)**2)
    if den<1e-8: continue
    s=np.sum((x-xb)*(y-yb))/den; o=yb-s*xb
    if not(sl<=s<=sh and offlo<=o<=offhi): continue
    resid=float(np.max(np.abs(s*x+o-y)))
    if resid<=3:
     out.append({'scale':float(s),'offset':float(o),'inliers':ns,'aisle_offset':g0-a0,'source_axis':src,'pinned':True,'max_residual_pt':round(resid,3),'pin':{'atlas':[a0,a1],'guide':[g0,g1]}})
 return out
xs=enum(0,0,.5,1.2,-300,500); ys=enum(1,1,.5,1.2,-100,400)
print('axis candidates',len(xs),len(ys))
profile=cal.load_profile('92'); scorer=cal.floor_scorer(profile,P)
# Precompute candidate source live segments in Atlas coords, and target feasibility uses x/y.
atlas_segments={}
for n,(group,point) in live.items(): atlas_segments[n]=corridor_segment(P,runs,group,point)

def label_options(x,y,n):
 seg=[[x['scale']*p[0]+x['offset'], y['scale']*p[1]+y['offset']] for p in atlas_segments[n]]
 opts=[]
 for name,q in G.items():
  if name.startswith('AISLE ') and label_fits_segment(q,seg): opts.append(int(name.split()[1]))
 return set(opts),nearest_aisle(G,seg),seg
# dynamic programming: map unique observed current labels to adds; unshifted outside ranges is add=0. Allow contiguous run ranges.
labels=sorted(live)
def best_shifts(options):
 # DP by partition of labels into groups; group uses one add in intersection, cost segments plus small add. Also allow group add0.
 m=len(labels); dp=[None]*(m+1);dp[0]=(0,0,0,[])
 for i in range(m):
  if dp[i] is None: continue
  inter=None
  for j in range(i,m):
   n=labels[j]; adds={g-n for g in options[n]}
   inter=adds if inter is None else inter&adds
   if not inter: break
   # choose add with least abs then nonzero penalty; preserve ranges if add 0 can be identity no explicit range
   choices=sorted(inter,key=lambda a:(a"'!=0,abs(a),a))
   add=choices[0]
   # group cost: explicit shift only if nonzero; identity group can merge but DP segmentation still
   segcost=0 if add==0 else 1
   prev=dp[i]; cand=(prev[0]+segcost,prev[1]+abs(add),max(prev[2],abs(add)),prev[3]+[(labels[i],labels[j],add)])
   old=dp[j+1]
   if old is None or cand[:3]<old[:3]:dp[j+1]=cand
 return dp[m]

rank=[]; checked=0
for x in xs:
 for y in ys:
  if abs(x['"'scale']/y['scale']-1)>0.05: continue
  # floor scorer sample; candidate passed only if the offline gate can plausibly pass
  sample_score=scorer({'x':x,'y':y})
  if sample_score < .99: continue
  opts={}; maps={}; anybad=False
  for n in labels:
   opts[n],maps[n],seg=label_options(x,y,n)
   if not opts[n]: anybad=True;break
  if anybad: continue
  shifts=best_shifts(opts)
  if shifts is None: continue
  # get exact floor check only now
  rec=cal.fit(Ageom,Ggeom,{'x':x['pin'],'y':y['pin']},floor=scorer)
  floor=cal.floor_check(profile,rec,P)
  if not floor['pass']: continue
  checked+=1
  # score: few nonzero shift ranges; small shifts; long anchor support; residual; floor
  rank.append((shifts[0],shifts[1],shifts[2],-len(x['inliers'])-len(y['inliers']),x,y,floor,opts,maps,shifts))
print('passing coherent candidates',checked)
rank.sort(key=lambda q:(q[0],q[1],q[2],q[3]))
for q in rank[:120]:
 segs,absadd,maxadd,neg_n,x,y,floor,opts,maps,sh=q
 print(f\"segments={segs} absadd={absadd} maxadd={maxadd} floor={floor['on_floor_pct']:.2f} n={-neg_n} x s{x['scale']:.5f} o{x['offset']:.2f} {x['pin']} y s{y['scale']:.5f} o{y['offset']:.2f} {y['pin']} shifts={sh[3]} got={maps} opts={opts}\")
