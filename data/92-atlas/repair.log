def load(path):
 with open(path) as f:return json.load(f)
A=load('data/92-atlas/geometry.json');G=load('data/92/geometry.json')
def segments(d, trans=lambda p:p):
 out=[]
 for s in d.get('fixtures',[]): out.append([trans((s[0],s[1])),trans((s[2],s[3]))])
 for poly in d.get('fixture_polys',[]):
  for a,b in zip(poly,poly[1:]+poly[:1]): out.append([trans(tuple(a)),trans(tuple(b))])
 return out

