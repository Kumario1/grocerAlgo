import json,itertools,math
from router import calibrate as c
A=c.load_atlas('92'); G=json.load(open('data/92/geometry.json')); aa=c.aisle_anchors(A['geometry']['anchors']); ga=c.aisle_anchors(G['anchors']); profile=c.load_profile('92'); score=c.floor_scorer(profile,A['psas']);
def candidates(axis,source):
 out=[]; nums=sorted(aa)
 for i,a0 in enumerate(nums):
  for a1 in nums[i+1:]:
   for shift in range(-70,71):
    ns=[n for n in range(a0,a1+1) if n in aa]
    if not all(n+shift in ga for n in ns): continue
    pin={'atlas':[a0,a1],'guide':[a0+shift,a1+shift]}
    f=c._pinned(aa,ga,pin,axis,source)
    if f['max_residual_pt']<=c.TOL_PT and c.SCALE_BAND[0]<=abs(f['scale'])<=c.SCALE_BAND[1]:
     out.append((f,pin))
 return out
xs=candidates(0,0); ys=candidates(1,1)
print('counts',len(xs),len(ys))
for name,cs in [('x',xs),('y',ys)]:
 print('\\n',name)
 for f,pin in sorted(cs,key=lambda z:(-len(z[0]['inliers']),z[0]['max_residual_pt'],abs(z[0]['scale']-1)))[:100]:
  print(pin,'n',len(f['inliers']),'shift',f['aisle_offset'],'scale',round(f['scale'],5),'off',round(f['offset'],2),'res',f['max_residual_pt'],'inliers',f['inliers'])
# combine with skew, footprint; rank floor percentage and total points
pairs=[]
for xf,xpin in xs:
 for yf,ypin in ys:
  if not c._skew_ok(xf,yf) or xf['source_axis']==yf['source_axis']: continue
  if not c._footprint_ok((xf,yf),A['geometry'],G): continue
  rec={'x':xf,'y':yf}
  fs=score(rec)
  pairs.append((fs,len(xf['inliers'])+len(yf['inliers']),xf['max_residual_pt']+yf['max_residual_pt'],xpin,ypin,xf,yf))
print('\\npaired',len(pairs))
for row in sorted(pairs,reverse=True,key=lambda r:(r[0],r[1],-r[2]))[:120]:
 fs,n,res,xp,yp,xf,yf=row
 print(f'floor={fs:.4f} anchors={n} res={res:.3f} x={xp} y={yp} scales=({xf[\"scale\"]:.5f},{yf[\"scale\"]:.5f}) offs=({xf[\"offset\"]:.2f},{yf[\"offset\"]:.2f})')
