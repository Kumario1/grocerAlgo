from scipy.spatial import cKDTree

def pts(path,step=8):
 d=json.load(open(path)); out=[]
 def add(a,b):
  a=np.array(a,float);b=np.array(b,float); length=np.linalg.norm(b-a); n=max(1,int(length/step));
  out.extend((a+(b-a)*(i/n)) for i in range(n+1))
 for s in d.get('fixtures',[]): add(s[:2],s[2:])
 for poly in d.get('fixture_polys',[]):
  for a,b in zip(poly,poly[1:]+poly[:1]):add(a,b)
 return np.unique(np.round(np.array(out),3),axis=0)
A=pts('data/92-atlas/geometry.json');G=pts('data/92/geometry.json')
print('points',len(A),len(G))
treeG=cKDTree(G); treeA=cKDTree(A)
def cost(sx,ox,sy,oy,trim=.9):
 T=A*np.array([sx,sy])+np.array([ox,oy])
 d1=treeG.query(T,k=1)[0]; d2=treeA.query((G-np.array([ox,oy]))/np.array([sx,sy]),k=1)[0]
 # ignore points outside guide page using d cap? quantile means
 return np.mean(np.sort(d1)[:int(len(d1)*trim)])+np.mean(np.sort(d2)[:int(len(d2)*trim)])
