+    away = floor_map(profile)
+    free, _, cell, _ = profile
+    height, width = free.shape
+    runs = shelf_runs(psas)
+    keys = list(psas)
+    if sample:
+        keys = keys[::max(1, len(keys) // sample)]
+    points = np.asarray([
+        to_corridor(
+            runs,
+            f"PSA:{key.split('|', 2)[0]}:{key.split('|', 2)[1]}",
+            psas[key],
+        )
+        for key in keys
