import json, numpy as np
from router.calibrate import aisle_anchors
with open('data/92-atlas/geometry.json') as f: A=aisle_anchors(json.load(f)['anchors'])
with open('data/92/geometry.json') as f: G=aisle_anchors(json.load(f)['anchors'])

def enum(src,tgt,lo=.6,hi=.9):
 out=[]
 nums=sorted(A)
 for i,a0 in enumerate(nums):
  for a1 in nums[i+1:]:
   span=a1-a0
   for g0 in range(1,61-span):
    g1=g0+span
    ns=[n for n in range(a0,a1+1) if n in A and n+(g0-a0) in G]
    if len(ns)<2: continue
    x=np.array([A[n][src] for n in ns]); y=np.array([G[n+g0-a0][tgt] for n in ns])
    slope,off=np.polyfit(x,y,1)
    if not (lo<=abs(slope)<=hi): continue
    resid=max(abs(slope*x+off-y))
    if resid<=3:
     out.append((resid,slope,off,a0,a1,g0,g1,tuple(ns)))
 return sorted(out)
for name,src,tgt in [('x',0,0),('y',1,1)]:
 o=enum(src,tgt)
 print(name,'count',len(o))
 # retain fits within offset bands, show lowest residual and diverse long intervals
 for q in sorted(o,key=lambda z:(z[7].__len__(),z[0]))[-80:]:
  pass
 print('best long')
 for q in sorted(o,key=lambda z:(-len(z[7]),z[0]))[:80]:
  print(f\"res{q[0]:.3f} s{q[1]:.5f} off{q[2]:.2f} A[{q[3]},{q[4]}] G[{q[5]},{q[6]}] n={q[7]}\")
 print('near scale .755 and expected offsets')
 shown=0
 for q in o:
  if abs(abs(q[1])-.755)<.01 and ((name=='x' and 0<q[2]<300) or (name=='y' and 50<q[2]<250)):
   print(f\"res{q[0]:.3f} s{q[1]:.5f} off{q[2]:.2f} A[{q[3]},{q[4]}] G[{q[5]},{q[6]}] n={q[7]}\")
   shown+=1
   if shown>=120: break
