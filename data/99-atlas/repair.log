import json, collections, numpy as np
from router import calibrate as c
p=json.load(open('data/99-atlas/psas.json'))
# all run lines, same logic but retain area
out=collections.defaultdict(list)
for key,point in p.items():
 area,aisle,_,_=key.split('|'); out[(area,aisle)].append(point)
for aisle in sorted({a for _,a in out if a.isdigit()},key=int):
 lines=[]
 for (area,a),pts in out.items():
  if a"'!=aisle or len(pts)<4: continue
  low=[min(x[i] for x in pts) for i in (0,1)]; high=[max(x[i] for x in pts) for i in (0,1)]
  ext=[high[i]-low[i] for i in (0,1)]; axis=0 if ext[0]<ext[1] else 1
  if ext[axis]*2>ext[1-axis]: continue
  lines.append((area,axis,(low[axis]+high[axis])/2,len(pts),ext))
 print('"'aisle',aisle, ' | '.join(f'{area}:cross{axis}={v:.1f} n{n} ext{e[0]:.0f},{e[1]:.0f}' for area,axis,v,n,e in sorted(lines)))
