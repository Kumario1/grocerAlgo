def pin(axis):
 o=[]
 for a0 in aa:
  for a1 in aa:
   if a1<=a0:continue
   for s in range(-20,21):
    if a0+s not in ga or a1+s not in ga:continue
    f=c._pinned(aa,ga,{'atlas':[a0,a1],'guide':[a0+s,a1+s]},axis)
    if f['max_residual_pt']<=3 and 1.15<=f['scale']<=1.35 and -250<=f['offset']<=350:o.append((a0,a1,s,f))
 return o
xs,ys=pin(0),pin(1)
print('candidates',len(xs),len(ys))
# Exact score over all pairs with skew/footprint. Keep top unique transform rounded.
free,reach,cell,m=profile;away=c.floor_map(profile);runs=c.shelf_runs(P);keys=list(P);points=np.asarray([c.to_corridor(runs,f\"PSA:{k.split('|',2)[0]}:{k.split('|',2)[1]}\",P[k]) for k in keys])
best=[]; passes=[]
for xa0,xa1,xsft,x in xs:
 cx=((x['scale']*points[:,0]+x['offset'])//cell).astype(int)
 for ya0,ya1,ysft,y in ys:
  if not c._skew_ok(x,y) or not c._footprint_ok((x,y),A,G):continue
  cy=((y['scale']*points[:,1]+y['offset'])//cell).astype(int);inside=(0<=cx)&(cx<away.shape[1])&(0<=cy)&(cy<away.shape[0]);landed=np.full(len(points),np.inf);landed[inside]=away[cy[inside],cx[inside]];score=float(np.mean(landed<=c.MAX_SNAP_M))
  rec=(score,xa0,xa1,xsft,ya0,ya1,ysft,x,y)
  if score>=.99:passes.append(rec)
  if len(best)<100 or score>best[0][0]:best.append(rec);best.sort(key=lambda z:z[0]);best=best[-100:]
print('passes',len(passes))
for row in sorted(passes,reverse=True,key=lambda z:z[0])[:120]:
 sc,xa0,xa1,xsft,ya0,ya1,ysft,x,y=row
 print(f'PASS {sc*100:.3f}% X{xa0}-{xa1}{xsft:+}({x[\"scale\"]:.5f},{x[\"offset\"]:.2f}) Y{ya0}-{ya1}{ysft:+}({y[\"scale\"]:.5f},{y[\"offset\"]:.2f}) res{x[\"max_residual_pt\"]},{y[\"max_residual_pt\"]}')
print('best')
for row in sorted(best,reverse=True,key=lambda z:z[0])[:100]:
 sc,xa0,xa1,xsft,ya0,ya1,ysft,x,y=row
 print(f'{sc*100:.3f}% X{xa0}-{xa1}{xsft:+}({x[\"scale\"]:.5f},{x[\"offset\"]:.2f}) Y{ya0}-{ya1}{ysft:+}({y[\"scale\"]:.5f},{y[\"offset\"]:.2f})')
