import json, warnings, numpy as np
from router import calibrate as c
warnings.simplefilter('ignore')
A=json.load(open('data/99-atlas/geometry.json')); G=json.load(open('data/99/geometry.json')); P=json.load(open('data/99-atlas/psas.json')); profile=c.load_profile('99')
aa=c.aisle_anchors(A['anchors']); ga=c.aisle_anchors(G['anchors'])
# Generate every supported pinned affine for a target axis, default source axis.
def pinned(axis):
 out=[]
 for a0 in sorted(aa):
  for a1 in sorted(aa):
   if a1<=a0: continue
   for s in range(-45,46):
    g0=a0+s;g1=a1+s
    if g0 not in ga or g1 not in ga:continue
    f=c._pinned(aa,ga,{'atlas':[a0,a1],'guide':[g0,g1]},axis)
    if f['max_residual_pt']<=c.TOL_PT and c.SCALE_BAND[0]<=abs(f['scale'])<=c.SCALE_BAND[1]:
     out.append((a0,a1,s,f))
 return out
xs=pinned(0); ys=pinned(1)
print('candidates',len(xs),len(ys))
free,reach,cell,m=profile
away=c.floor_map(profile)
# reproduce sample points used by floor_scorer
runs=c.shelf_runs(P); keys=list(P); keys=keys[::max(1,len(keys)//400)]
points=np.asarray([c.to_corridor(runs,f\"PSA:{k.split('|',2)[0]}:{k.split('|',2)[1]}\",P[k]) for k in keys])
# preserve candidates with physical footprint
